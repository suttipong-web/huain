RewriteEngine On

# Keep redirects relative to current app directory (works at root and subfolder installs)

# Keep legacy query URLs as-is to avoid host-specific redirect issues.

# Pretty routes
RewriteRule ^$ index.php [L,QSA]
RewriteRule ^products/?$ products.php [L,QSA]
RewriteRule ^products/([^/]+)/?$ product.php?slug=$1 [L,QSA]
RewriteRule ^news/?$ news.php [L,QSA]
RewriteRule ^news/([^/]+)/?$ news-detail.php?slug=$1 [L,QSA]
RewriteRule ^contact/?$ contact.php [L,QSA]

# Admin shortcut
RewriteRule ^admin/?$ admin/login.php [L,QSA]
